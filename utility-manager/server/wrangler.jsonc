// Cloudflare Workers deployment of SRD Utility Manager.
// A separate Worker from the old dashboard (srd-project-manager), so both can
// run side by side until the switch-over.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "srd-utility-manager",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    // API calls go to the Worker; everything else is the web app.
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "LOG_LEVEL": "info",
    "APP_TIMEZONE": "Indian/Maldives",
    "PUBLIC_URL": "https://srd-utility-manager.abdul-salaam2005.workers.dev"
  },
  // Secret (not here): TELEGRAM_BOT_TOKEN, set with `npx wrangler secret put`.
  // Morning Telegram summary at 07:45 Maldives time (02:45 UTC).
  "triggers": { "crons": ["45 2 * * *"] },
  // Database connection: Hyperdrive config "srd-utility-db", pointing at the
  // Supabase session pooler (port 5432) with origin_connection_limit 10:
  // the pooler takes only 15 clients, and at Hyperdrive's default (60) its
  // pool filled them and pages failed with "max clients reached". Don't use
  // the transaction pooler (6543): through Hyperdrive requests hung.
  // srd-utility-manager Supabase project (created with
  // `npx wrangler hyperdrive create srd-utility-db --connection-string=…`).
  // Query caching is DISABLED on this config (`wrangler hyperdrive update <id>
  // --caching-disabled true`): with it on, lists showed old data for up to a
  // minute after a change (e.g. a new user not appearing until refresh).
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "66f58338402f4355aa04b25b0df4c38c",
      // Used by `npm run dev:cloudflare` only: a local Postgres for testing.
      "localConnectionString": "postgres://postgres:postgres@localhost:5432/srd"
    }
  ],
  // Run next to the database (Supabase, AWS Mumbai) rather than next to the
  // visitor: a page makes several queries one after another, and each one
  // from Malé took about 120 ms; from Mumbai it is a few ms.
  "placement": { "region": "aws:ap-south-1" },
  "observability": { "enabled": true }
}
