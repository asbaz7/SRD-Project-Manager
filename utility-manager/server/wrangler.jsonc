// Cloudflare Workers deployment of SRD Utility Manager.
// A separate Worker from the old dashboard (srd-project-manager), so both can
// run side by side until the switch-over.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "srd-utility-manager",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    // API calls go to the Worker; everything else is the web app.
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "LOG_LEVEL": "info",
    "APP_TIMEZONE": "Indian/Maldives",
    "PUBLIC_URL": "https://srd-utility-manager.abdul-salaam2005.workers.dev"
  },
  // Secret (not here): TELEGRAM_BOT_TOKEN, set with `npx wrangler secret put`.
  // Morning Telegram summary at 07:45 Maldives time (02:45 UTC).
  "triggers": { "crons": ["45 2 * * *"] },
  // Database connection: Hyperdrive config "srd-utility-db", pointing at the
  // srd-utility-manager Supabase project (created with
  // `npx wrangler hyperdrive create srd-utility-db --connection-string=…`).
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "66f58338402f4355aa04b25b0df4c38c",
      // Used by `npm run dev:cloudflare` only: a local Postgres for testing.
      "localConnectionString": "postgres://postgres:postgres@localhost:5432/srd"
    }
  ],
  "observability": { "enabled": true }
}
