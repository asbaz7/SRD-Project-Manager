{
  "name": "@srd/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../.env src/index.js",
    "start": "node --env-file-if-exists=../.env src/index.js",
    "migrate": "node --env-file-if-exists=../.env scripts/migrate.js",
    "seed": "node --env-file-if-exists=../.env scripts/seed.js",
    "create-admin": "node --env-file-if-exists=../.env scripts/create-admin.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "demo": "node scripts/demo.js",
    "deploy:cloudflare": "wrangler deploy",
    "dev:cloudflare": "wrangler dev"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.11",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "wrangler": "^4.143.0"
  }
}
