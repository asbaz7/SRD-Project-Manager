# PostgreSQL 15+ connection string. Leave empty in development to use the
# embedded database stored in PGLITE_DIR (never in production).
DATABASE_URL=
DATABASE_SSL=false
DATABASE_POOL_SIZE=10
PGLITE_DIR=./data/pglite

PORT=3000
# Set to true behind a reverse proxy / load balancer that sets X-Forwarded-*.
TRUST_PROXY=false
# Extra origins allowed to send cookie-authenticated writes (comma separated).
ALLOWED_ORIGINS=
SESSION_TTL_HOURS=12
# HTTPS-only session cookie (default: on in production). Set false ONLY when
# users reach the app over plain http:// on a trusted office network.
COOKIE_SECURE=
APP_TIMEZONE=Indian/Maldives
LOG_LEVEL=info
